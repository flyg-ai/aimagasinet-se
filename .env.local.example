# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — used by content-generation scripts + nightly cron
ANTHROPIC_API_KEY=sk-ant-...

# Unsplash — omslagsbilder för den nattliga artikel-genereringen
# (app/api/cron/generate-articles). Skapa en app på unsplash.com/developers.
UNSPLASH_ACCESS_KEY=...

# Cron-skydd — sätt samma värde i Vercel. Vercel Cron skickar det som
# Authorization: Bearer <CRON_SECRET> till /api/cron/generate-articles.
CRON_SECRET=...

# Optional — direkt Postgres-anslutning för att köra migrationer
# (scripts/apply-migration.ts). Dashboard → Project Settings → Database → URI.
# DATABASE_URL=postgres://...

# Resend — used by /api/subscribe to send welcome emails.
# Subscriptions still work without this; the welcome email is best-effort.
RESEND_API_KEY=re_...
# Optional — defaults to "AI-Magasinet <noreply@aimagasinet.se>" if unset.
# Must use a domain verified on resend.com.
# RESEND_FROM=AI-Magasinet <noreply@aimagasinet.se>
